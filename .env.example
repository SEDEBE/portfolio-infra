# Copy to .env on the server (chmod 600) and fill in real values. Never commit .env.

# Root domain: the landing is served here and the expense tracker on gastos.<DOMAIN>
DOMAIN=example.com
# Let's Encrypt sends certificate expiry warnings here
ACME_EMAIL=you@example.com

# Django (generate the key with: python3 -c "import secrets; print(secrets.token_urlsafe(50))")
SECRET_KEY=change-me
DEFAULT_FROM_EMAIL=Gastos <no-reply@example.com>
# consolemail:// prints emails to the logs. For real delivery with Resend:
#   EMAIL_URL=smtp+tls://resend:<api-key>@smtp.resend.com:587
# (port 587: Hetzner blocks outgoing 25 and 465 on new accounts)
EMAIL_URL=consolemail://

# Postgres
POSTGRES_DB=expenses
POSTGRES_USER=expenses
POSTGRES_PASSWORD=change-me-too

# Sign in with Google: OAuth client ID (public). Empty turns it off.
GOOGLE_CLIENT_ID=

# Umami (visit statistics). Generate each with: openssl rand -hex 32
UMAMI_DB_PASSWORD=change-me
UMAMI_APP_SECRET=change-me

# Error tracking for the API (Sentry DSN). Empty turns it off.
SENTRY_DSN=
