# Caddy gets and renews Let's Encrypt certificates for every site below on its own,
# and redirects HTTP to HTTPS.
{
	email {$ACME_EMAIL}
}

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

# Portfolio landing page
{$DOMAIN} {
	import common
	reverse_proxy landing:80
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# Expense tracker: the React app and its API share one origin, so the browser needs no CORS.
gastos.{$DOMAIN} {
	import common
	@django path /api/* /admin/* /static/*
	handle @django {
		# The API, its docs and the admin are not pages to show in search results.
		header X-Robots-Tag "noindex, nofollow"
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy web:80
	}
}

# Visit statistics (Umami): the dashboard, and the script and endpoint the pages report to.
estadisticas.{$DOMAIN} {
	import common
	# A private dashboard: keep it out of search engines.
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy umami:3000
}
